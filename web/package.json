{
  "name": "salary-management-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:style": "stylelint \"src/**/*.scss\" --allow-empty-input --fix",
    "tsc": "tsc -b --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run lint:style && npm run tsc && npm run test"
  },
  "dependencies": {
    "@mantine/core": "9.7.4",
    "@mantine/form": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@mantine/notifications": "9.7.4",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-query": "5.104.5",
    "axios": "1.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
