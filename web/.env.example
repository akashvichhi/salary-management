# Base URL of the API. Local development: the FastAPI server. Leave unset in production,
# where FastAPI serves this app from the same origin and "/" is used.
VITE_API_URL=http://localhost:8000/

# Optional: fills in the login form, so the demo needs one click. Built into the JavaScript, so
# anyone who opens the app can read them: only ever the demo account (api/.env HR_MANAGER_*).
VITE_DEMO_LOGIN_EMAIL=hr@example.com
VITE_DEMO_LOGIN_PASSWORD=Hr@2026
