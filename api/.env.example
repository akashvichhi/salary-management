# SQLAlchemy database URL. Defaults to a SQLite file in the api/ folder.
DATABASE_URL=sqlite:///./salary_management.db

# Browser origins allowed through CORS, as a JSON list. Local development only (the Vite
# dev server runs on another port); leave unset in production.
ALLOWED_ORIGINS=["http://localhost:5173"]

# The session cookie is Secure (HTTPS only) unless this is false. Local http development only.
COOKIE_SECURE=false
# Optional: the cookie name and how long a login lasts.
# SESSION_COOKIE_NAME=session_id
# SESSION_TTL_HOURS=8

# true only behind a proxy that appends the caller's IP to X-Forwarded-For (Render). Unset, the
# header is ignored, because without such a proxy the caller writes it.
# TRUST_FORWARDED_FOR=false

# The HR manager the seed script creates (`make seed`). Choose your own; never commit real ones.
HR_MANAGER_EMAIL=hr@example.com
HR_MANAGER_PASSWORD=Hr@2026

# Optional: units of each currency per US dollar, as JSON, for the figures the insights show in
# USD. Needs every currency, with USD at 1. Unset, the defaults in constants/currency_constants.py
# apply. Example:
# EXCHANGE_RATES={"AED": "3.6725", "AUD": "1.471", "CAD": "1.426", "EUR": "0.904", "GBP": "0.756", "INR": "94.16", "SGD": "1.278", "USD": "1"}
